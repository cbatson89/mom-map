VITE_MAPBOX_TOKEN=your_mapbox_access_token_here

# Supabase (client-safe — VITE_ prefix means these are bundled into the app)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side only — used by scripts/seed-spots.js. No VITE_ prefix so it is
# NEVER bundled into client code. Keep local; do not commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
